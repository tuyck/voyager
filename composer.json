{
  "name": "tuyck/voyager",
  "description": "A Laravel Admin Package to make your life easier and steer your project in the right direction",
  "keywords": [
    "laravel",
    "admin",
    "panel"
  ],
  "license": "MIT",
  "homepage": "https://voyager.tuyck.com/",
  "support": {
    "issues": "https://github.com/tuyck/voyager/issues",
    "source": "https://github.com/tuyck/voyager"
  },
  "authors": [
    {
      "name": "Alireza Nazari",
      "email": "alireza.ginbox@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/support": "~10.0|~11.0",
    "intervention/image": "^2.7|^3.0",
    "doctrine/dbal": "^3.1|^3.5|^4.0",
    "laravel/ui": "^4.0",
    "arrilot/laravel-widgets": "^3.7",
    "league/flysystem": "~3.0",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpcov": ">=8.0",
    "phpunit/phpunit": ">=10.0",
    "laravel/framework": "~10.0",
    "orchestra/testbench": ">=8.0",
    "laravel/browser-kit-testing": ">=6.1.0",
    "orchestra/testbench-browser-kit": ">=7.0"
  },
  "autoload": {
    "psr-4": {
      "Tuyck\\Voyager\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tuyck\\Voyager\\Tests\\": "tests/",
      "Tuyck\\Voyager\\Tests\\Database\\Factories\\": "tests/database/factories/",
      "Database\\Seeders\\": "vendor/orchestra/testbench-core/laravel/database/seeders"
    }
  },
  "minimum-stability": "stable",
  "extra": {
    "laravel": {
      "providers": [
        "Tuyck\\Voyager\\VoyagerServiceProvider",
        "Tuyck\\Voyager\\Providers\\VoyagerDummyServiceProvider"
      ]
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php vendor/bin/testbench package:discover --ansi"
    ]
  }
}
